# ┌──────────────────────────────────────────────────────────────┐
# │  MODELO — copie para secrets.toml e preencha                  │
# │  NUNCA envie o secrets.toml preenchido para o GitHub ou chat  │
# └──────────────────────────────────────────────────────────────┘

# ── 1. Banco na nuvem (Turso) ──────────────────────────────────
# Onde achar: painel do Turso → seu banco → "Connect"
[turso]
url = "libsql://SEU-BANCO-SEUUSUARIO.turso.io"
auth_token = "COLE_O_TOKEN_AQUI"

# ── 2. Login com Google ────────────────────────────────────────
# Onde achar: Google Cloud → APIs e Serviços → Credenciais
[auth]
redirect_uri = "http://localhost:8504/oauth2callback"
cookie_secret = "GERE_UMA_FRASE_ALEATORIA_LONGA_AQUI"

[auth.google]
client_id = "COLE_O_CLIENT_ID_AQUI"
client_secret = "COLE_O_CLIENT_SECRET_AQUI"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── 3. Quem pode entrar ────────────────────────────────────────
# Só estes e-mails conseguem acessar. Qualquer outro é barrado.
[acesso]
emails_autorizados = [
    "fabricioaguilherme@gmail.com",
    # "email.da.sua.esposa@gmail.com",
]
