# ┌──────────────────────────────────────────────────────────────┐
# │  MODELO — copie para secrets.toml e preencha                  │
# │  NUNCA envie o secrets.toml preenchido para o GitHub ou chat  │
# └──────────────────────────────────────────────────────────────┘

# ── 1. Banco na nuvem (Turso) ──────────────────────────────────
# Onde achar: painel do Turso → seu banco → "Connect"
[turso]
url = "libsql://SEU-BANCO-SEUUSUARIO.turso.io"
auth_token = "COLE_O_TOKEN_AQUI"

# ── 2. Login com Google ────────────────────────────────────────
# Onde achar: Google Cloud → APIs e Serviços → Credenciais
[auth]
redirect_uri = "http://localhost:8504/oauth2callback"
cookie_secret = "GERE_UMA_FRASE_ALEATORIA_LONGA_AQUI"

[auth.google]
client_id = "COLE_O_CLIENT_ID_AQUI"
client_secret = "COLE_O_CLIENT_SECRET_AQUI"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── 3. Quem pode entrar ────────────────────────────────────────
# Só estes e-mails conseguem acessar. Qualquer outro é barrado.
[acesso]
emails_autorizados = [
    "fabricioaguilherme@gmail.com",
    # "email.da.sua.esposa@gmail.com",
]

# ── 4. Quem manda no sistema ───────────────────────────────────
# Ser "admin" so da poder dentro do proprio grupo. Estes aqui criam grupos
# e enxergam a lista de todos eles. Lista vazia = ninguem.
emails_super_admin = [
    "fabricioaguilherme@gmail.com",
]

# ── 5. De onde cada um pode entrar ─────────────────────────────
# Estes entram de qualquer rede (casa, 3G, viagem).
emails_qualquer_rede = [
    "fabricioaguilherme@gmail.com",
]

# Todos os demais so entram por estas faixas. Aceita IP exato
# ("189.4.5.6") ou bloco ("189.4.5.0/24" / "2804:7f0:6800:8eee::/64").
#
# ATENCAO: coloque o IPv4 **e** o IPv6 da casa. A maioria das operadoras
# entrega os dois, e o celular costuma sair por IPv6 enquanto o notebook sai
# por IPv4 — com so um deles na lista, a pessoa e barrada dependendo do
# aparelho que estiver usando.
#
# Descubra os dois numeros na tela de Administracao do app.
# Vazio = ninguem fora da lista acima entra (falha fechada, de proposito).
redes_liberadas = [
    # "SEU.IPV4.DE.CASA",
    # "SEU:PREFIXO:IPV6:DA:CASA::/64",
]

# Leitura da foto do cupom (tela "📷 Foto do Cupom").
# Sem esta chave a tela avisa e não quebra nada — o resto do app funciona igual.
[anthropic]
api_key = "sk-ant-..."
